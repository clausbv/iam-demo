# Copiaza in .env si completeaza. Incarca cu:  export $(cat .env | xargs)
# (sau foloseste python-dotenv daca preferi)

FLASK_SECRET=ceva-random-lung

# --- OKTA ---
# Discovery: din tenant-ul tau. Foloseste authorization server "default" sau org.
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DISCOVERY=https://integrator-6711838.okta.com/oauth2/default/.well-known/openid-configuration

# --- ENTRA ID ---
# TENANT_ID = Directory (tenant) ID din App Registration.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DISCOVERY=https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration
